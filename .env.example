# Application
APP_ENV=development
APP_URL=http://localhost:3000
APP_TIME_ZONE=Asia/Tashkent
BUGUNBOR_DEMO_SEED=true

# Target production adapters (not used by the Sites D1 checkpoint)
DATABASE_URL=postgresql://bugunbor:change-me@localhost:5432/bugunbor
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=bugunbor-media
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

# Auto Scheduler — shared secret a Cloudflare Cron Trigger presents to
# POST /api/v1/admin/scheduler/tick. Leave unset in local/dev.
CRON_SECRET=

# Providers — leave unset to keep fail-closed development adapters
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
PAYMENT_PROVIDER_SECRET=
MAPS_PROVIDER_API_KEY=
PUSH_PROVIDER_SECRET=

# NFCStore — separate system and secrets
NFCSTORE_ISSUER=
NFCSTORE_CLIENT_ID=
NFCSTORE_CLIENT_SECRET=
NFCSTORE_WEBHOOK_SECRET=
