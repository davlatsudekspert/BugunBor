# Application
APP_ENV=development
APP_URL=http://localhost:3000
APP_TIME_ZONE=Asia/Tashkent
BUGUNBOR_DEMO_SEED=true

# Target production adapters (not used by the Sites D1 checkpoint)
DATABASE_URL=postgresql://bugunbor:change-me@localhost:5432/bugunbor
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=bugunbor-media
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

# Providers — leave unset to keep fail-closed development adapters
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
PAYMENT_PROVIDER_SECRET=
MAPS_PROVIDER_API_KEY=
PUSH_PROVIDER_SECRET=

# NFCStore — separate system and secrets
NFCSTORE_ISSUER=
NFCSTORE_CLIENT_ID=
NFCSTORE_CLIENT_SECRET=
NFCSTORE_WEBHOOK_SECRET=

# Admin panel (/admin) — phone + Telegram OTP sign-in
# 1. Create a bot with @BotFather and copy its token here.
# 2. Message the bot from the phone number below, then open
#    https://api.telegram.org/bot<token>/getUpdates to read that chat's id.
# Without a real token+chat id, login codes are only logged to the server
# console in local development and are never faked as "sent" in production.
TELEGRAM_BOT_TOKEN=
ADMIN_BOOTSTRAP_PHONE=+998900000000
ADMIN_BOOTSTRAP_TELEGRAM_CHAT_ID=

# Admin panel — post promotions to a Telegram channel from /admin/announcements.
# Add the bot as an admin of your channel, then set its @username or numeric id.
TELEGRAM_ANNOUNCE_CHANNEL_ID=

# /telegram Mini App reuses TELEGRAM_BOT_TOKEN above to verify Telegram.WebApp.initData.
# In @BotFather: /newapp against the same bot, with the Mini App URL set to
# https://<your-domain>/telegram. Update the bot @username in
# components/telegram-mini-app.tsx's deep link (currently a placeholder).
