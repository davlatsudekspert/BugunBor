# BugunBor configuration. Set these as Cloudflare Worker variables/secrets;
# locally, `npm run dev` runs in demo mode without any of them.

# Public origin used in Telegram links and QR codes.
APP_URL=https://bugunbor.uz

# Long random secret (32+ characters). Derives redemption codes and hashes IPs.
# Set once before launch and never change it: active codes would stop working.
HASH_SECRET=

# Telegram login bot and notifications (@BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string; Telegram sends it back on every webhook call.
TELEGRAM_WEBHOOK_SECRET=

# Phones that become platform admins on their first Telegram login.
ADMIN_PHONES=+998901234567

# Show the fictional demo catalogue in production (development always shows it).
DEMO_SEED=false
