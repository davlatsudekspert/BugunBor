# Application
APP_ENV=development
APP_URL=http://localhost:3000
APP_TIME_ZONE=Asia/Tashkent
BUGUNBOR_DEMO_SEED=true

# Database — required. Points at the Postgres instance this app reads/writes
# (docker-compose up postgres for local dev; on Railway, add a Postgres plugin
# and reference it as ${{Postgres.DATABASE_URL}}). See docs/operations.md.
DATABASE_URL=postgresql://bugunbor:local-only-change-me@localhost:5432/bugunbor

# Target production adapters not yet wired up (see docs/product-spec.md)
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=bugunbor-media
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

# Auto Scheduler — shared secret a recurring scheduler (a Railway Cron Job
# calling POST /api/v1/admin/scheduler/tick, or any external one) presents.
# Leave unset in local/dev.
CRON_SECRET=

# Providers — leave unset to keep fail-closed development adapters
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
PAYMENT_PROVIDER_SECRET=
MAPS_PROVIDER_API_KEY=
PUSH_PROVIDER_SECRET=

# NFCStore — separate system and secrets
NFCSTORE_ISSUER=
NFCSTORE_CLIENT_ID=
NFCSTORE_CLIENT_SECRET=
NFCSTORE_WEBHOOK_SECRET=
