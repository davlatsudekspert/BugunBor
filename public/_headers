# Content-hashed build assets never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Photos, icons and logos: fresh for a day, then refreshed in the background
# (they keep their names when replaced, so they are not immutable).
/photos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/payments/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
