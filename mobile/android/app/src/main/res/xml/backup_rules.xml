<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. The session token (secure storage) is never copied
     to a backup: its key lives in this phone's Keystore only. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
</full-backup-content>
